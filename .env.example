# Deployment Configuration

# Deployment stage (e.g., 'development', 'staging', 'production')
DEPLOY_STAGE=production

# AWS S3 bucket name where the app will be deployed
S3_BUCKET=my-wedding-app-bucket

# AWS CloudFront distribution ID
CLOUDFRONT_DISTRIBUTION_ID=E1234ABCD5678

# AWS Region
AWS_REGION=us-east-1

# Optional: AWS profile (if not using default credentials)
# AWS_PROFILE=my-profile
